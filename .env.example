# T-Central Hub environment template
# Copy this file to .env.local for local development and set matching variables in Vercel for production.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# App URLs + session cryptography
# Required in production, for Steam login redirects, and for protected PayPal donation/subscription return URLs.
# NEXT_PUBLIC_APP_URL is the public browser-facing origin. APP_URL is the trusted server-side origin.
# SESSION_SECRET signs/encrypts the Steam session cookie; use a long random secret in production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-secret"

# -----------------------------------------------------------------------------
# Steam login
# Steam OpenID login uses NEXT_PUBLIC_APP_URL for the callback origin and SESSION_SECRET for the session cookie.
# STEAM_API_KEY is required when you want enriched Steam profile data during login; without it the app can fall back to a SteamID-only session.
# -----------------------------------------------------------------------------
STEAM_API_KEY="replace-with-steam-web-api-key"

# -----------------------------------------------------------------------------
# Supabase persistence
# Required for durable production storage of protected donation/support ledgers, webhook reconciliation, contact/report data, and multiplayer/admin server writes.
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are safe public client values.
# SUPABASE_SERVICE_ROLE_KEY is server-only and must stay secret.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# -----------------------------------------------------------------------------
# PayPal one-time protected donations
# Required for the Steam/Google account-linked one-time PayPal checkout flow:
# - NEXT_PUBLIC_PAYPAL_CLIENT_ID
# - PAYPAL_CLIENT_SECRET
# - PAYPAL_ENV (sandbox or live)
# - PAYPAL_CURRENCY (defaults to USD when omitted)
# PAYPAL_WEBHOOK_ID is required when receiving/verifying PayPal webhooks for durable reconciliation.
# Protected donations also depend on the app URL/session, Steam or Google login, and Supabase settings above.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID="replace-with-paypal-client-id"
PAYPAL_CLIENT_SECRET="replace-with-paypal-client-secret"
PAYPAL_WEBHOOK_ID="replace-with-paypal-webhook-id"
PAYPAL_ENV="sandbox"
PAYPAL_CURRENCY="USD"

# -----------------------------------------------------------------------------
# PayPal recurring subscriptions
# Required in addition to the one-time PayPal settings when enabling Steam-linked recurring subscription purchases.
# Use the plan ID from the matching PayPal sandbox/live environment.
# -----------------------------------------------------------------------------
PAYPAL_SUBSCRIPTION_PLAN_ID="replace-with-paypal-subscription-plan-id"

# -----------------------------------------------------------------------------
# PayPal.Me fallback
# Automatic account history uses authenticated checkout and requires PayPal API credentials.
# Direct voluntary support remains available at https://paypal.me/TCentralG.
# Historical external gifts need receipt review before they can be associated with an account.
# -----------------------------------------------------------------------------

# Optional private financial reporting: both fields must match a verified account.
# Provider must be steam or google. Keep blank to deny financial administration.
PAYMENTS_ADMIN_PROVIDER=
PAYMENTS_ADMIN_ACCOUNT_ID=

# Shared universe: one persistent game-service process, 1–128 total pilots.
NEXT_PUBLIC_MULTIPLAYER_ROOM="tcentral-main"
MULTIPLAYER_MAX_PLAYERS="128"
# Legacy HTTP adapter only: never enable memory storage on Vercel.
MULTIPLAYER_ALLOW_IN_MEMORY="false"

# Website and separate game service must share this server-only secret (>=32 random characters).
REALTIME_SERVER_SECRET=""
# Website only: reachable private/public HTTP address of the persistent game service.
REALTIME_SERVER_URL=""
# Website only: public browser endpoint. Use wss:// with HTTPS websites.
NEXT_PUBLIC_REALTIME_WS_URL=""
# Game service only: explicit comma-separated website origins; no wildcard.
# The public proxy must support WebSocket upgrades for /flight and /chat.
REALTIME_ALLOWED_ORIGINS="https://t-central.me"
# Game service accepts PORT (default 8080). Start it separately: npm run server:realtime.
# Legacy HTTP adapters are development-only. Production always requires the real-time
# service; MULTIPLAYER_TRANSPORT=http cannot bypass authoritative production flight.

# Private player reports and account bans (website only). Comma-separated verified
# provider:account IDs, copied from /profile. With no SITE_OWNER_ACCOUNT or
# provider-qualified legacy owner, leaving this blank denies all moderation UI.
# Example: MODERATION_ADMIN_ACCOUNTS="google:YOUR_GOOGLE_SUB,steam:YOUR_STEAMID64"
MODERATION_ADMIN_ACCOUNTS=""
# The persistent game service also needs NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY to enforce durable bans on join and during play.
# Preferred single owner binding (website only). Copy the complete stable ID
# from the owner's authenticated /profile, e.g. google:... or steam:....
# A provider-qualified legacy DYSON_ADMIN_PROVIDER + DYSON_ADMIN_ACCOUNT_ID
# also identifies an owner when SITE_OWNER_ACCOUNT is absent.
SITE_OWNER_ACCOUNT=""

# Security baseline: session and private-data keys are separate, server-only.
# SESSION_SECRET must be a cryptographically random string of at least 32 bytes.
# Generate a session secret with: openssl rand -base64 48
SESSION_KEY_ID="current"
# JSON map of retained old session key IDs to their old SESSION_SECRET values.
# Leave empty for the first v3 deployment. Legacy v1/v2 login cookies are rejected.
SESSION_PREVIOUS_KEYS=""
# Optional only while recovering legacy Prayer Seed cookies after sign-in.
SESSION_LEGACY_SECRET=""

# Private Prayer Seed text: JSON map of key IDs to base64-encoded 32-byte keys.
# Generate each data key with: openssl rand -base64 32
# Install the migration and keys before enabling new private seed saves.
DATA_ENCRYPTION_KEY_ID=""
DATA_ENCRYPTION_KEYS=""

# Owner or a separate >=32-character maintenance credential is required for
# cleanup, symmetry checks, simulation-event ingestion and continuity operations.
# Supply the service credential as Authorization: Bearer ...; never expose it publicly.
MAINTENANCE_API_SECRET=""
