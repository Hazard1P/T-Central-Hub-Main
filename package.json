{
  "name": "t-central-hub-vercel-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "verify:simulation": "npm test && npm run verify:api && npm run build",
    "verify:usernames-db": "node scripts/verify-usernames-db.mjs",
    "verify:api": "node scripts/verify-api-routes.mjs",
    "check:dyson-continuity": "node scripts/check-dyson-continuity.mjs",
    "release:notes": "node scripts/generate-dyson-release-notes.mjs",
    "migrate:dyson-state": "node scripts/migrate-dyson-state.mjs",
    "ci:continuity": "npm run check:dyson-continuity && npm run release:notes",
    "release:entropy-pdf": "node scripts/generate-entropy-frontpage-pdf.mjs",
    "drill:continuity": "node scripts/run-continuity-drill.mjs",
    "server:realtime": "node server/realtime.mjs",
    "verify:moderation-db": "node scripts/verify-moderation-db.mjs",
    "verify:community-db": "node scripts/verify-community-db.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
