    "verify:security-db": "node scripts/verify-security-db.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "^2.49.8",
    "@vercel/analytics": "^2.0.1",
    "astronomy-engine": "2.1.19",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.184.0",
    "ws": "^8.22.0"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "postcss": "8.5.32"
  }
}
